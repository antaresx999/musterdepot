# Einstellungen für Musterdepot (liegt nach der Installation in /etc/musterdepot.env)
# Nach Änderungen: systemctl restart musterdepot

# Adresse und Port des Webservers
MUSTERDEPOT_HOST=0.0.0.0
MUSTERDEPOT_PORT=8080

# Name oben links und im Browser-Tab
MUSTERDEPOT_SITE_NAME=Musterdepot

# Datenverzeichnis (Datenbank, Schlüssel)
MUSTERDEPOT_DATA=/var/lib/musterdepot

# Erstes Admin-Konto. Ohne Passwort wird eines erzeugt und in
# /var/lib/musterdepot/initial-admin-password.txt abgelegt.
MUSTERDEPOT_ADMIN_USER=admin
#MUSTERDEPOT_ADMIN_PASSWORD=

# Auf 1 setzen, wenn die Seite nur über HTTPS (Reverse Proxy) erreichbar ist
MUSTERDEPOT_COOKIE_SECURE=0

# Wie oft Kurse geholt und Limit-/Stop-Aufträge geprüft werden (Sekunden)
MUSTERDEPOT_REFRESH_SECONDS=300

# Optional: kostenloser Demo-Schlüssel von CoinGecko für höhere Abfragelimits
#MUSTERDEPOT_COINGECKO_KEY=

# 1 = keine Kurse aus dem Internet (nur manuelle Titel)
MUSTERDEPOT_OFFLINE=0
